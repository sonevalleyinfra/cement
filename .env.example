# Copy this file to .env for local development:  cp .env.example .env
# On Coolify, `pnpm launch` sets these for you (see README "Put it online").
# Every variable is checked by src/env.ts — the app will not start if one is wrong.

# Port of the local database on your computer (docker-compose.dev.yml).
# Only used on your computer. `pnpm new-app` picks a free one for each project.
LOCAL_DB_PORT=5433

# Postgres connection string.
# Local: matches docker-compose.dev.yml (the port must equal LOCAL_DB_PORT).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app

# Secret used to sign sessions and tokens. At least 32 characters.
# Generate one with:  openssl rand -base64 32
# Use a different value in production and never commit it.
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public URL of the app (used in email links and cookie settings).
# Optional on Coolify: if empty, COOLIFY_URL (set by Coolify on every
# deployment, including previews) is used instead.
BETTER_AUTH_URL=http://localhost:3000

# Resend API key (https://resend.com/api-keys).
# Not needed while EMAIL_MODE=log.
RESEND_API_KEY=

# Sender for all emails. The domain must be verified in Resend.
EMAIL_FROM=App Factory <noreply@example.com>

# log       = print emails to the console, send nothing (local development)
# allowlist = send only to addresses in EMAIL_ALLOWLIST (staging / previews)
# live      = send to everyone (production)
EMAIL_MODE=log

# Comma-separated addresses that may receive email when EMAIL_MODE=allowlist.
EMAIL_ALLOWLIST=

# First admin account. Created on startup if no admin exists yet.
# Password: at least 6 characters locally, 12 in production (pnpm launch makes a random one).
# Change it after the first sign-in: Dashboard -> Change password.
SEED_ADMIN_EMAIL=sonevalleyinfra@gmail.com
SEED_ADMIN_PASSWORD=123456
